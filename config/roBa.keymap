/*
 * roBa キーマップ — Cornix LP（48キー・Vial）と操作感をそろえた版
 *
 * 2026-08-07 改訂。設計の根拠は docs/要件-Cornixとそろえる.md
 *
 * 面（覚えるのは 0〜5 の6つ。6・7 はトラックボールが自動で切り替える）
 *   0 通常 / 1 数字記号（左親指まんなか 長押し） / 2 機能（右親指まんなか 長押し）
 *   3 矢印・移動（左親指いちばん外 長押し） / 4 LoL / 5 WASD系 / 6 マウス / 7 スクロール
 *
 * 🔴 日本語入力は LANG1（日本語にする）/ LANG2（英語にする）を使う。
 *    無変換・変換はこのPCでは信号が届かない（Windows が英語101/102として扱うため）。
 *
 * 矢印は hjkl 方式（矢印の面で H=← J=↓ K=↑ L=→）。
 * 同じ面で左手がまるごと修飾キーになるので、Ctrl+Shift+→ が指1本ずつで押せる。
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <6>;
    scroll-layers = <7>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        // どの面にいても、通常の面へ戻って英語入力にする
        to_base_eng {
            bindings = <&to_layer_0 LANG2>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 親指の押し分け: 軽く押す＝1・2 ／ 押し続ける＝3・4
        // WASD を押しっぱなしにするゲームで、指を動かさずキャラを切り替えるため
        num_ht: num_ht {
            compatible = "zmk,behavior-hold-tap";
            label = "NUM_HOLD_TAP";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ───────── 0. 通常 ─────────
           左親指: 日本語 / Space(長押し=数字記号) / 英語(長押し=矢印)
           右親指: BS / Enter(長押し=機能) / Del
           Z を押しっぱなしで Shift、Q+W の同時押しで Tab                */
        default_layer {
            bindings = <
&kp Q             &kp W         &kp E         &kp R          &kp T                                        &kp Y        &kp U        &lt 7 I     &kp O      &kp P
&kp A             &kp S         &kp D         &kp F          &kp G          &kp ESC      &kp MINUS        &kp H        &kp J        &kp K       &kp L      &kp SQT
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V          &kp B          &kp COLON    &kp SEMICOLON    &kp N        &kp M        &kp COMMA   &kp DOT    &kp SLASH
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &lt 2 LANG1    &lt 1 SPACE    &lt_to_layer_0 3 LANG2         &kp BSPC     &lt 2 ENTER  &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        /* ───────── 1. 数字と記号（左親指まんなか 長押し）─────────
           Cornix と同じ並び。1の下が「!」、2の下が「@」               */
        num_layer {
            bindings = <
&kp N1        &kp N2        &kp N3        &kp N4            &kp N5                                            &kp N6         &kp N7         &kp N8            &kp N9          &kp N0
&kp EXCL      &kp AT        &kp HASH      &kp DOLLAR        &kp PERCENT     &kp GRAVE      &kp PIPE           &kp MINUS      &kp EQUAL      &kp LBKT          &kp RBKT        &kp SQT
&kp CARET     &kp AMPS      &kp ASTRK     &kp LPAR          &kp RPAR        &kp UNDER      &kp BSLH           &kp COLON      &kp DQT        &kp QMARK         &kp PLUS        &kp TILDE
&trans        &trans        &trans        &trans            &trans          &trans                            &trans         &trans         &trans
            >;
        };

        /* ───────── 2. 機能（右親指まんなか 長押し／左親指の日本語キー 長押し）─────────
           F1〜F12 は左手。ゲーム中も左手だけで届く                      */
        function_layer {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4            &kp F5                                            &kp HOME       &kp PG_DN      &kp PG_UP         &kp END         &kp DEL
&kp F6        &kp F7        &kp F8        &kp F9            &kp F10         &kp F11        &kp F12            &kp C_MUTE     &kp C_VOL_DN   &kp C_VOL_UP      &kp C_PREV      &kp C_NEXT
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &tog 4            &tog 5          &kp PSCRN      &kp INS            &kp LS(LG(S))  &kp K_APP      &trans            &bt BT_CLR      &bootloader
&trans        &trans        &trans        &trans            &trans          &trans                            &trans         &trans         &trans
            >;
        };

        /* ───────── 3. 矢印・移動（左親指いちばん外 長押し）─────────
           左手がまるごと修飾キー、右手が hjkl の矢印                    */
        arrow_layer {
            bindings = <
&kp ESC       &trans        &trans        &trans            &trans                                            &trans         &trans         &trans            &trans          &trans
&kp LEFT_WIN  &kp LEFT_ALT  &kp LSHFT     &kp LCTRL         &trans          &trans         &trans             &kp LEFT       &kp DOWN       &kp UP            &kp RIGHT       &trans
&trans        &trans        &trans        &trans            &trans          &trans         &trans             &kp HOME       &kp PG_DN      &kp PG_UP         &kp END         &trans
&trans        &trans        &trans        &trans            &trans          &trans                            &trans         &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        /* ───────── 4. LoL（機能の面から入り、右手いちばん内側で戻る）─────────
           持ち物 1〜7。よく押す 1・2 はホームの段、4（ワード）は親指     */
        lol_layer {
            bindings = <
&kp Q         &kp W         &kp E         &kp R             &kp N7                                            &to 0          &trans         &trans            &trans          &trans
&kp N1        &kp N2        &kp D         &kp F             &kp G           &kp ESC        &trans             &trans         &trans         &trans            &trans          &trans
&kp Z         &kp N3        &kp N5        &kp N6            &kp B           &trans         &trans             &trans         &trans         &trans            &trans          &trans
&kp LCTRL     &kp Y         &sl 2         &kp SPACE         &kp LALT        &kp N4                            &trans         &trans         &trans
            >;
        };

        /* ───────── 5. WASD系（原神・鳴潮・ゼンレス・スターレイル）─────────
           文字キーを1つも潰さない。1・2 は親指、押し続けると 3・4       */
        wasd_layer {
            bindings = <
&kp Q         &kp W         &kp E         &kp R             &kp T                                             &to 0          &trans         &trans            &trans          &trans
&kp A         &kp S         &kp D         &kp F             &kp G           &kp ESC        &trans             &trans         &trans         &trans            &trans          &trans
&kp Z         &kp X         &kp C         &kp V             &kp B           &trans         &trans             &trans         &trans         &trans            &trans          &trans
&kp LCTRL     &kp LALT      &sl 2         &kp SPACE         &num_ht N3 N1   &num_ht N4 N2                     &trans         &trans         &trans
            >;
        };

        /* ───────── 6. マウス（トラックボールを動かすと自動）───────── */
        mouse_layer {
            bindings = <
&trans        &trans        &trans        &trans            &trans                                            &trans         &trans         &trans            &trans          &trans
&trans        &trans        &trans        &trans            &trans          &trans         &trans             &trans         &mkp MB1       &mkp MB3          &mkp MB2        &trans
&trans        &trans        &trans        &trans            &trans          &trans         &trans             &trans         &trans         &trans            &trans          &trans
&trans        &trans        &trans        &trans            &trans          &trans                            &trans         &trans         &trans
            >;
        };

        /* ───────── 7. スクロール（I を押しながら）───────── */
        scroll_layer {
            bindings = <
&trans        &trans        &trans        &trans            &trans                                            &trans         &trans         &trans            &trans          &trans
&trans        &trans        &trans        &trans            &trans          &trans         &trans             &trans         &trans         &trans            &trans          &trans
&trans        &trans        &trans        &trans            &trans          &trans         &trans             &trans         &trans         &trans            &trans          &trans
&trans        &trans        &trans        &trans            &trans          &trans                            &trans         &trans         &trans
            >;
        };
    };
};
